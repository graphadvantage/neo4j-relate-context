# Copy to .env and fill in the enterprise context Aura connection.
# Agent MCP servers keep their own NEO4J_* settings.
AURA_URI=neo4j+s://your-instance.databases.neo4j.io
AURA_USERNAME=neo4j
AURA_PASSWORD=
AURA_DATABASE=neo4j

# Optional: manual Aura GenAI embedding smoke test (never commit a real key).
OPENAI_API_KEY=
# OPENAI_API_KEY also enables the console's background Desktop-intent promotion
# and shared recall backend (text-embedding-3-small, 1536 dimensions).
