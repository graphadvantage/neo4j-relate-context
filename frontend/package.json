{
  "name": "relate-capture-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "build": "node --max-old-space-size=3072 node_modules/vite/bin/vite.js build",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@neo4j-cypher/react-codemirror": "0.0.0-canary-20260904090349",
    "@neo4j-ndl/base": "4.20.1",
    "@neo4j-ndl/react": "4.21.1",
    "@neo4j-ndl/react-graph": "2.1.20",
    "@neo4j-nvl/base": "^1.2.0",
    "@neo4j-nvl/interaction-handlers": "^1.2.0",
    "@neo4j-nvl/layout-workers": "^1.2.0",
    "@neo4j-nvl/react": "^1.2.0",
    "react": "^19",
    "react-dom": "^19",
    "elkjs": "^0.11.0",
    "@tanstack/react-table": "^8.21.3"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "terser": "^5.51.2",
    "typescript": "^5",
    "vite": "^6.4.4"
  },
  "overrides": {
    "@neo4j-cypher/react-codemirror": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "js-cookie": "^3.0.7",
    "zod": "^4.6.6",
    "katex": "^0.18.2"
